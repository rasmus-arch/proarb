{
  "name": "proarb",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": ["apps/api", "apps/web"],
  "scripts": {
    "dev": "concurrently -n api,css -c blue,green \"pnpm --filter @proarb/api dev\" \"pnpm --filter @proarb/web dev\"",
    "css:build": "pnpm --filter @proarb/web build",
    "db:migrate": "node apps/api/db/migrate.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
