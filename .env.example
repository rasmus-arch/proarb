# Copy this file to .env and adjust as needed.

# MySQL connection (matches docker-compose.yml defaults)
DB_HOST=localhost
DB_PORT=3306
DB_USER=proarb
DB_PASSWORD=proarb
DB_NAME=proarb

# API
PORT=3001

# Buggrapportering -> GitHub issues: repo + personal access token fylls i
# under Inställningar i appen (inte här) så det går att sätta upp utan
# omdeploy. Utan dem sparas rapporter ändå i databasen (bug_reports), men
# synkas inte till GitHub.
# TENANT_NAME: valfritt — vilken kund den här driftsatta instansen tillhör
#   (t.ex. "Profil & Arbetskläder AB"), stämplas på issuet/som GitHub-label
#   så flera kunders rapporter går att skilja åt i samma repo. Bara relevant
#   om samma repo tar emot rapporter från fler än en driftsättning.
TENANT_NAME=
