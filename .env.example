# Copy this file to .env and adjust as needed.

# MySQL connection (matches docker-compose.yml defaults)
DB_HOST=localhost
DB_PORT=3306
DB_USER=proarb
DB_PASSWORD=proarb
DB_NAME=proarb

# API
PORT=3001

# Buggrapportering -> GitHub issues (valfritt). Utan dessa sparas
# rapporter ändå i databasen (bug_reports), men synkas inte till GitHub.
# GITHUB_ISSUES_TOKEN: ett fine-grained personal access token, skapat på
#   https://github.com/settings/personal-access-tokens/new, begränsat till
#   just detta repo med behörigheten "Issues: Read and write".
# GITHUB_ISSUES_REPO: "ägare/repo", t.ex. rasmus-arch/proarb.
# TENANT_NAME: valfritt — vilken kund den här driftsatta instansen tillhör
#   (t.ex. "Profil & Arbetskläder AB"), stämplas på issuet/som GitHub-label
#   så flera kunders rapporter går att skilja åt i samma repo.
GITHUB_ISSUES_TOKEN=
GITHUB_ISSUES_REPO=
TENANT_NAME=
